{
  "name": "hookforge-nextjs",
  "version": "0.0.2-canary.23bf755",
  "description": "React/Next.js Hooks Library",
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "nextjs",
    "next"
  ],
  "homepage": "https://github.com/zuxcode/hookforge#readme",
  "bugs": {
    "url": "https://github.com/zuxcode/hookforge/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zuxcode/hookforge.git"
  },
  "license": "MIT",
  "author": "Alfred Chigozie Nwanokwai <zuxcode@gmail.com>",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && tsdown",
    "check": "ultracite check",
    "check-types": "tsgo --noEmit",
    "clean": "rimraf dist",
    "cz": "git-cz",
    "fix": "ultracite fix",
    "release": "semantic-release",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "hookforge-core": "workspace:*",
    "tsdown": "^0.23.0"
  },
  "devDependencies": {
    "@hookforge/typescript-config": "workspace:*",
    "next": "^16.3.4",
    "react": "^19.2.8"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18.2.0"
  }
}
